#!/bin/bash
# Trading Dashboard launcher — double-click to start (no terminal needed).
# Lives inside the repo at: <repo>/Trading Dashboard.app/Contents/MacOS/launcher

REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
LOG="/tmp/trading-dashboard.log"

# GUI-launched apps get a minimal PATH — search common python3 locations
# and pick the first one that has the dashboard dependencies installed.
CANDIDATES=(
    "$(command -v python3 2>/dev/null)"
    "$HOME/trading-venv/bin/python3"
    "$REPO/venv/bin/python3"
    "$REPO/.venv/bin/python3"
    /opt/homebrew/bin/python3
    /usr/local/bin/python3
    /usr/bin/python3
    "$HOME/.pyenv/shims/python3"
    "$HOME/miniforge3/bin/python3"
    "$HOME/miniconda3/bin/python3"
    "$HOME/anaconda3/bin/python3"
    /opt/homebrew/opt/python3/bin/python3
)

PY=""
for p in "${CANDIDATES[@]}"; do
    [ -n "$p" ] && [ -x "$p" ] || continue
    if "$p" -c "import fastapi, uvicorn" >/dev/null 2>&1; then
        PY="$p"
        break
    fi
done

if [ -z "$PY" ]; then
    # Show which pythons we found (but lacked deps) to help debugging
    FOUND=""
    for p in "${CANDIDATES[@]}"; do
        [ -n "$p" ] && [ -x "$p" ] && FOUND="$FOUND\n  $p"
    done
    MSG="No Python with fastapi+uvicorn found."
    [ -n "$FOUND" ] && MSG="$MSG\n\nPythons found (missing deps):$FOUND"
    MSG="$MSG\n\nOpen Terminal and run:\n  python3 -m venv ~/trading-venv\n  source ~/trading-venv/bin/activate\n  pip install fastapi uvicorn"
    osascript -e "display dialog \"$MSG\" buttons {\"OK\"} default button \"OK\" with title \"Trading Dashboard\"" >/dev/null 2>&1
    exit 1
fi

cd "$REPO" || exit 1
echo "=== Launched $(date) with $PY ===" >> "$LOG"

# Start server in background so macOS sees the launcher exit cleanly
"$PY" run_dashboard.py >> "$LOG" 2>&1 &
